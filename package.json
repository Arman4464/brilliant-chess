{
  "name": "chessmate",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/Arman4464/chessmate",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "serve": "node server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "calibrate": "node scripts/train_and_calibrate.js",
    "benchmark": "node scripts/test_ground_truth_benchmark.js",
    "test": "node tests/test_complete_parity_suite.js",
    "test:parity": "node tests/test_complete_parity_suite.js",
    "test:accuracy": "node scripts/analyze_sample_accuracies.js",
    "test:weights": "node scripts/test_calibrated_weights.js",
    "test:speed": "node scripts/test_sf_speed.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -t"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.6",
    "howler": "^2.2.4",
    "next": "^15.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.2",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "gh-pages": "^6.3.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
