{
  "name": "chessmate",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/Arman4464/chessmate",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "serve": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "calibrate": "node scripts/train_and_calibrate.js",
    "benchmark": "node scripts/test_ground_truth_benchmark.js",
    "test": "node tests/test_complete_parity_suite.js",
    "test:parity": "node tests/test_complete_parity_suite.js",
    "test:accuracy": "node scripts/analyze_sample_accuracies.js",
    "test:weights": "node scripts/test_calibrated_weights.js",
    "test:speed": "node scripts/test_sf_speed.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -t"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "chess.js": "^1.4.0",
    "howler": "^2.2.4",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
